# ============================================================================
# AVA PCO — variáveis de ambiente
# Copie para .env (ou .env.local) e preencha. NUNCA comite o .env real.
# ============================================================================

# --- Cliente (prefixo VITE_ obrigatório) ---

# URL base da API. Em dev, deixe vazio para usar /api (proxy do Vite).
# Em produção, defina apenas se a API estiver em outro domínio.
# VITE_API_URL=

# Sentry (opcional). Se definido, frontend reporta erros em produção.
# Requer: npm install @sentry/react
# VITE_SENTRY_DSN=

# --- Servidor / API ---

# Origens permitidas para CORS, separadas por vírgula
ALLOWED_ORIGINS=http://localhost:5173

# OAuth Google (opcional — habilita botão "Entrar com Google" no /login).
# Crie credenciais em: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI deve ser: <PUBLIC_ORIGIN>/api/auth/oauth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=  # default: <PUBLIC_ORIGIN>/api/auth/oauth/google/callback
# PUBLIC_ORIGIN=https://ava.psicanaliseclinica.online

# SAML SSO (opcional — habilita /api/auth/saml/login pra IDPs corporate).
# IMPORTANTE: implementacao atual NAO valida assinatura do IDP — confia
# no transporte HTTPS + IDP cadastrado. Para prod hardened, adicione
# xml-crypto + verificacao do certificado X.509.
# SAML_ISSUER=ava-pco                                    # entityID do SP
# SAML_IDP_SSO_URL=https://idp.example.com/saml/sso       # endpoint do IDP
# SAML_ACS_URL=https://ava.psicanaliseclinica.online/api/auth/saml/acs

# Postgres (Neon serverless). Sem isso, o sistema usa fallback in-memory.
# Crie em: https://console.neon.tech → New Project → copie connection string
# Formato: postgres://USER:PASSWORD@HOST/dbname?sslmode=require
# DATABASE_URL=

# Master key (32 bytes em hex) para criptografar API keys de IA em repouso.
# Obrigatória em produção. Gere com: openssl rand -hex 32
# AI_KEY_ENCRYPTION_SECRET=

# Clerk (auth). Para substituir o AuthContext mockado.
# Crie em: https://dashboard.clerk.com/
# CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=

# Sentry server-side (opcional). Se ausente, captureException é no-op.
# Format: https://<publicKey>@<host>/<projectId>
# SENTRY_DSN=
# SENTRY_RELEASE=ava-pco@0.1.0  # opcional, marca o release no Sentry

# S3 backup remoto (opcional). Se as 4 vars estiverem setadas, o
# backup-worker sobe data/backups/YYYY-MM-DD/*.json para S3 a cada
# snapshot diário. Sem elas, backup é só local.
# S3_BUCKET=meu-bucket
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BACKUP_PREFIX=ava-pco-backups   # opcional, default 'ava-pco-backups'

# ============================================================================
# IMPORTANTE: chaves de API de IAs (Anthropic, OpenAI, Google, Mistral,
# DeepSeek, Groq) NÃO são definidas aqui. Elas são configuradas pelo admin
# em /admin/ias e armazenadas no servidor (criptografadas em produção).
# ============================================================================
